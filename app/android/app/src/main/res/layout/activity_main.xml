<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050607">

    <!-- 1. Precision Grid Wallpaper Background with dark shade -->
    <ImageView
        android:id="@+id/wallpaperImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/wallpaper_graphite_night"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3050607" />

    <!-- 2. Main Desktop UI Hierarchy -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Status Bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <!-- Time & Date -->
            <TextClock
                android:id="@+id/clockTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="HH:mm"
                android:format24Hour="HH:mm"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextClock
                android:id="@+id/clockDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:format12Hour="M月d日 E"
                android:format24Hour="M月d日 E"
                android:textColor="#99FFFFFF"
                android:textSize="13sp" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Demo Environment Pill Indicator -->
            <TextView
                android:id="@+id/topDemoIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧪 模拟器演示环境"
                android:textColor="#3BE2C0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_tire_chip"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

            <!-- Weather Status Pill -->
            <TextView
                android:id="@+id/topWeatherText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="晴 18°C"
                android:textColor="#EFF4F6"
                android:textSize="12sp"
                android:background="@drawable/bg_tire_chip"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="12dp" />

            <!-- System Connectivity Pill -->
            <TextView
                android:id="@+id/topSystemStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4G | 蓝牙已连接"
                android:textColor="#8A99AD"
                android:textSize="12sp"
                android:background="@drawable/bg_tire_chip"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </LinearLayout>

        <!-- Central Workspace ViewPager2 -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/workspaceViewPager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <!-- Desktop Smooth Page Indicator -->
        <xyz.i4o.uni.launcher.desktop.DesktopPageIndicator
            android:id="@+id/desktopPageIndicator"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:layout_marginBottom="4dp" />

        <!-- Unified Complete UNI Bottom Dock (Supports Floating Capsule and Full-Width OEM styles) -->
        <xyz.i4o.uni.launcher.desktop.FullOemDockView
            android:id="@+id/fullOemDockView"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:visibility="visible" />

        <!-- Bottom Floating Edit Mode Bar -->
        <FrameLayout
            android:id="@+id/editBarContainer"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="140dp"
            android:layout_marginEnd="140dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_dock_capsule"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <TextView
                    android:id="@+id/editAddCardBtn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="➕ 添加卡片"
                    android:textColor="#3BE2C0"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_dock_item_glass"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/editResetBtn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="🔄 恢复默认"
                    android:textColor="#EFF4F6"
                    android:textSize="14sp"
                    android:background="@drawable/bg_dock_item_glass"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/editDoneBtn"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="✅ 完成编辑"
                    android:textColor="#3BE2C0"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_dock_pill_accent"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
